<script>
        // Micro-interaction for the progress bar pulsing
        const progressFill = document.querySelector('.bg-primary.w-1\\/2');
        if (progressFill) {
            setInterval(() => {
                progressFill.style.opacity = progressFill.style.opacity === '0.8' ? '1' : '0.8';
            }, 2000);
        }

        // Simulating the recording "wave" behavior if microphone is active
        const micBtn = document.querySelector('[data-icon="mic"]').parentElement.parentElement;
        micBtn.addEventListener('mousedown', () => {
            micBtn.classList.add('bg-primary-container', 'border-primary');
            micBtn.querySelector('.material-symbols-outlined').style.color = '#2a14b4';
        });
        micBtn.addEventListener('mouseup', () => {
            micBtn.classList.remove('bg-primary-container', 'border-primary');
            micBtn.querySelector('.material-symbols-outlined').style.color = '';
        });
    </script>




