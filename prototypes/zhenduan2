<script>
        const sendBtn = document.getElementById('send-btn');
        const userInput = document.getElementById('user-input');
        const chatContainer = document.getElementById('chat-container');

        userInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                handleSend();
            }
        });

        sendBtn.addEventListener('click', handleSend);

        function handleSend() {
            const text = userInput.value.trim();
            if (text) {
                const userBubble = `
                    <div class="flex flex-row-reverse gap-md animate-in fade-in slide-in-from-bottom-2 duration-300">
                        <div class="flex-shrink-0">
                            <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-secondary-container">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuARnqEXrCPgYmZ_JXmBWLXPSm_qleODZrONwuv5d9_iWwQZnit6OFRe5Tlz82Rkt84BshBxYXo3MlRdQ-hzGDiPb9AEfHwWDl3YmnmP_tw0xS-PzhUTWTlaqfz8C0u1TEYxRIbT-1A6a3lvE5NHqTK58q2TQtBjvALIB7UMRAte1ZGyPc_OGUz60vza1pcI5J5N_zPkE2I7yi9DRKt1_kReRI760mPbLB4TGKJI7PCzv7evWn_Zqq1J0JrNufOGqTgKuvdl1_5YNqI" alt="用户头像" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div class="flex-1 flex flex-col items-end max-w-2xl">
                            <div class="bg-primary text-on-primary p-md rounded-xl rounded-tr-none shadow-md">
                                <p class="font-body-md leading-relaxed">${text}</p>
                            </div>
                            <span class="font-label-bold text-on-surface-variant opacity-60 mr-1 mt-2">你 • 刚刚</span>
                        </div>
                    </div>
                `;
                chatContainer.insertAdjacentHTML('beforeend', userBubble);
                userInput.value = '';
                
                chatContainer.scrollTo({
                    top: chatContainer.scrollHeight,
                    behavior: 'smooth'
                });

                setTimeout(() => {
                    const typingIndicator = `
                        <div id="typing" class="flex gap-md">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant">
                                    <span class="material-symbols-outlined animate-bounce" data-icon="more_horiz">more_horiz</span>
                                </div>
                            </div>
                            <div class="bg-surface-container-low p-4 rounded-xl">
                                <span class="font-body-sm text-on-surface-variant">AI 教练正在分析并准备深度追问...</span>
                            </div>
                        </div>
                    `;
                    chatContainer.insertAdjacentHTML('beforeend', typingIndicator);
                    chatContainer.scrollTo({
                        top: chatContainer.scrollHeight,
                        behavior: 'smooth'
                    });
                }, 800);
            }
        }

        window.onload = () => {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        };
    </script>




