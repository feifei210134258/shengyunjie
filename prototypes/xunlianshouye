<script>
        // Micro-interaction for the "Start Training" button
        const startBtn = document.querySelector('button.bg-on-primary-container');
        if (startBtn) {
            startBtn.addEventListener('mouseenter', () => {
                startBtn.querySelector('span').style.transform = 'translateX(4px)';
            });
            startBtn.addEventListener('mouseleave', () => {
                startBtn.querySelector('span').style.transform = 'translateX(0px)';
            });
            startBtn.addEventListener('mousedown', () => {
                startBtn.style.transform = 'scale(0.96)';
            });
            startBtn.addEventListener('mouseup', () => {
                startBtn.style.transform = 'scale(1)';
            });
        }

        // Add subtle parallax effect to glass cards on mouse move
        document.addEventListener('mousemove', (e) => {
            const cards = document.querySelectorAll('.glass-card');
            const mouseX = e.clientX / window.innerWidth - 0.5;
            const mouseY = e.clientY / window.innerHeight - 0.5;
            
            cards.forEach(card => {
                const rect = card.getBoundingClientRect();
                if (e.clientX > rect.left && e.clientX < rect.right && e.clientY > rect.top && e.clientY < rect.bottom) {
                    card.style.transform = `perspective(1000px) rotateY(${mouseX * 2}deg) rotateX(${-mouseY * 2}deg)`;
                } else {
                    card.style.transform = 'perspective(1000px) rotateY(0deg) rotateX(0deg)';
                }
            });
        });
    </script>


